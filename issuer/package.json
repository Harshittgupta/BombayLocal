{
  "name": "@bombaylocal/issuer",
  "version": "0.3.0",
  "description": "BombayLocal issuer service (SPEC v0.3): purchases, Merkle tree, Registry.postRoot, signed roots",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "publish-root": "tsx --env-file-if-exists=../.env src/cli-publish.ts",
    "arkiv-roundtrip": "tsx --env-file-if-exists=../.env scripts/arkiv-roundtrip.ts",
    "arkiv-expiry": "tsx --env-file-if-exists=../.env scripts/arkiv-expiry-demo.ts",
    "publish-scanners": "tsx --env-file-if-exists=../.env scripts/publish-scanners.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sign-fixtures": "tsx scripts/make-sign-fixtures.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@bombaylocal/protocol": "file:../protocol",
    "ethers": "6.17.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "snarkjs": "0.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
