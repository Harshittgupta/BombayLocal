{
  "name": "@unlink/circuits",
  "version": "0.3.0",
  "description": "Unlink pass circuit (SPEC v0.3 §4), Groth16 setup and sample prover",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "compile": "node -e \"require('fs').mkdirSync('build',{recursive:true})\" && circom pass.circom --r1cs --wasm --sym --O2 -l node_modules/circomlib/circuits -l node_modules/@zk-kit/binary-merkle-root.circom/src -o build",
    "info": "snarkjs r1cs info build/pass.r1cs",
    "ptau": "tsx scripts/fetch-ptau.ts",
    "setup": "npm run ptau && snarkjs groth16 setup build/pass.r1cs ptau/powersOfTau28_hez_final_13.ptau build/pass_0000.zkey",
    "contribute": "tsx scripts/contribute.ts",
    "vkey": "snarkjs zkey export verificationkey build/pass_final.zkey build/verification_key.json",
    "artifacts": "tsx scripts/copy-artifacts.ts",
    "build": "npm run compile && npm run info && npm run setup && npm run contribute && npm run vkey && npm run artifacts",
    "prove-sample": "tsx scripts/prove-sample.ts",
    "typecheck": "tsc --noEmit -p .",
    "bench": "tsx scripts/bench.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "verify-artifacts": "tsx scripts/verify-artifacts.ts",
    "verify-qr": "tsx scripts/verify-qr.ts"
  },
  "dependencies": {
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "circomlib": "2.0.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@unlink/protocol": "file:../protocol",
    "snarkjs": "0.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
