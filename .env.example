# Ethereum Sepolia
# SEPOLIA_RPC_URL=https://rpc.sepolia.org
# SEPOLIA_RPC_URL_BACKUP=https://ethereum-sepolia-rpc.publicnode.com
# ETHERSCAN_API_KEY=

# Wallets (never commit real keys)
# AUTHORITY_PRIVATE_KEY=
# ISSUER_PRIVATE_KEY=

# Arkiv
# ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# ARKIV_CHAIN_ID=7794095
# Optional: free key from https://hub.arkiv.network/access-keys (empty = public, rate-limited endpoint)
# ARKIV_ACCESS_KEY=

# Issuer service
# ISSUER_PORT=3000

# Issuer admin
# ADMIN_TOKEN=
